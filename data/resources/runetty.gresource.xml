    <file alias="rail-agents-symbolic.svg" preprocess="xml-stripblanks">icons/rail-agents-symbolic.svg</file>
    <file alias="rail-monitor-symbolic.svg" preprocess="xml-stripblanks">icons/rail-monitor-symbolic.svg</file>
    <file alias="pin-right-symbolic.svg" preprocess="xml-stripblanks">icons/pin-right-symbolic.svg</file>
    <file alias="unpin-symbolic.svg" preprocess="xml-stripblanks">icons/unpin-symbolic.svg</file>
  </gresource>
  <gresource prefix="/io/github/umutcanpurtul_avi/runetty/icons/scalable/apps">
    <file alias="io.github.umutcanpurtul_avi.runetty.svg" preprocess="xml-stripblanks">../icons/io.github.umutcanpurtul_avi.runetty.svg</file>
